[Unit]
Description=Agora host sync — espeja workers con MinIO/Back y revive contenedores edu-worker
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
User=humanizar
Group=humanizar
# Variables de entorno principales (WORKER_SECRET, WORKER_SYNC_SECRET, NEXUS_URL, etc.)
EnvironmentFile=/etc/agora-host-sync.env
# Fallback legacy para vars adicionales del host de workers
EnvironmentFile=-/etc/edu-worker/worker.env
ExecStart=/usr/bin/node /opt/agora-host-sync/agora-host-sync.mjs
Restart=always
RestartSec=10
StandardOutput=append:/home/humanizar/logs/agora-host-sync.log
StandardError=append:/home/humanizar/logs/agora-host-sync.log

[Install]
WantedBy=multi-user.target
