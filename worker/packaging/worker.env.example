# Worker Environment Configuration
# Copy this file to worker.env and fill in the values

NEXUS_URL=http://your-hub-ip:3010
# Backend URL for agora-host-sync (Cloud Run en producción).
AGORA_HUB_URL=https://agora-backend-578238159459.us-central1.run.app
WORKER_IMAGE=stevenvo780/edu-worker:latest
FIREBASE_BUCKET=your-project.firebasestorage.app
WORKER_SOCKET_SECRET=<shared-secret-for-hub-auth>
WORKER_SYNC_SECRET=<shared-secret-for-back-sync-auth>
# WORKER_SECRET remains supported as a temporary legacy fallback.

# Firebase config as JSON (minified)
FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","databaseURL":"https://your-project-rtdb.firebaseio.com"}
